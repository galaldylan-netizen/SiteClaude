<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ settings.site_name | escape }}</title>
    {% render 'css-variables' %}
    {{ 'orbyte.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'orbyte.js' | asset_url }}" defer></script>
    <script>document.documentElement.classList.replace('no-js','js');</script>
    {{ content_for_header }}
  </head>
  <body>
    <canvas class="starfield" data-starfield aria-hidden="true"></canvas>
    <main id="MainContent" class="main">{{ content_for_layout }}</main>
  </body>
</html>
