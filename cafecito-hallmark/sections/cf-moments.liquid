 {"type":"select","id":"bg","label":"Fond (non utilisé)","default":"cf-bg-ivory","options":[{"value":"cf-bg-ivory","label":"Blanc cassé"},{"value":"cf-bg-white","label":"Blanc"},{"value":"cf-bg-sand","label":"Beige"},{"value":"cf-bg-warm","label":"Dégradé chaud"}]},
 {"type":"text","id":"eyebrow","label":"Surtitre (non affiché)","default":"Au quotidien"},
 {"type":"inline_richtext","id":"title","label":"Titre","default":"Le café vous accompagne."},
 {"type":"textarea","id":"text","label":"Texte"}
],
"blocks":[{"type":"moment","name":"Moment","settings":[
 {"type":"image_picker","id":"image","label":"Image (format 2:3)"},
 {"type":"text","id":"tag","label":"Moment de la journée"},
 {"type":"text","id":"title","label":"Titre"},
 {"type":"textarea","id":"text","label":"Texte"}
]}],
"presets":[{"name":"Cafecito — Moments"}]}
{% endschema %}
