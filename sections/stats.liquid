<section class="section section--tight" aria-labelledby="Title-{{ section.id }}">
  <div class="container">
    <h2 id="Title-{{ section.id }}" class="visually-hidden">{{ section.settings.heading | escape }}</h2>
    <div class="stats">
      {%- for block in section.blocks -%}
        <div class="stat" data-count="{{ block.settings.value }}" data-decimals="{{ block.settings.decimals }}" {{ block.shopify_attributes }}>
          <div class="stat__value"><span data-count-out aria-hidden="true">{{ block.settings.value }}</span><span class="visually-hidden">{{ block.settings.value }}</span><span class="stat__unit">{{ block.settings.unit | escape }}</span></div>
          <p>{{ block.settings.text | escape }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Chiffres clés",
  "settings": [ { "type": "text", "id": "heading", "label": "Titre (lecteurs d'écran)", "default": "Chiffres clés" } ],
  "blocks": [
    { "type": "stat", "name": "Chiffre", "settings": [
      { "type": "text", "id": "value", "label": "Valeur (chiffres, point pour les décimales)", "default": "8" },
      { "type": "select", "id": "decimals", "label": "Décimales", "default": "0", "options": [ { "value": "0", "label": "0" }, { "value": "1", "label": "1" }, { "value": "2", "label": "2" } ] },
      { "type": "text", "id": "unit", "label": "Unité" },
      { "type": "text", "id": "text", "label": "Légende", "default": "Planètes" }
    ] }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Chiffres clés" }]
}
{% endschema %}
