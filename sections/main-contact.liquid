<section class="section section--tight">
  <div class="container narrow">
    <h1 class="split-words" data-split>{{ page.title | escape }}</h1>
    {%- if page.content != blank -%}<div class="rte">{{ page.content }}</div>{%- endif -%}
    <div class="card-box" style="margin-top: 2rem">
      {%- form 'contact', id: 'ContactForm' -%}
        {%- if form.posted_successfully? -%}
          <p class="form-message form-message--success" role="status" tabindex="-1" autofocus>{{ 'sections.contact.success' | t }}</p>
        {%- elsif form.errors -%}
          <div class="form-message form-message--error" role="alert" tabindex="-1" autofocus>{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <p class="hint">{{ 'general.required_fields' | t }}</p>
        <div class="field">
          <label for="ContactName">{{ 'sections.contact.name' | t }}</label>
          <input id="ContactName" name="contact[name]" autocomplete="name" value="{{ form.name }}">
        </div>
        <div class="field">
          <label for="ContactEmail">{{ 'sections.contact.email' | t }} <span class="required" aria-hidden="true">*</span></label>
          <input id="ContactEmail" type="email" name="contact[email]" autocomplete="email" required aria-required="true" value="{{ form.email }}">
        </div>
        <div class="field">
          <label for="ContactOrder">{{ 'sections.contact.order' | t }}</label>
          <input id="ContactOrder" name="contact[order]" value="">
        </div>
        <div class="field">
          <label for="ContactBody">{{ 'sections.contact.message' | t }} <span class="required" aria-hidden="true">*</span></label>
          <textarea id="ContactBody" name="contact[body]" required aria-required="true">{{ form.body }}</textarea>
        </div>
        <p class="hint">{{ 'sections.contact.privacy' | t }}{% if shop.privacy_policy.body != blank %} <a href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title }}</a>.{% endif %}</p>
        <button type="submit" class="button">{{ 'sections.contact.send' | t }}</button>
      {%- endform -%}
    </div>
  </div>
</section>
{% schema %}
{ "name": "Contact", "settings": [] }
{% endschema %}
