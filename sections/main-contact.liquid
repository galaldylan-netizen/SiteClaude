<section class="section page-head">
  <div class="container narrow">
    <p class="label"><span class="blink" aria-hidden="true"></span>{{ 'contact.label' | t }}</p>
    <h1 class="h2" data-scramble>{{ page.title | escape }}</h1>
    {%- if page.content != blank -%}<div class="rte">{{ page.content }}</div>{%- endif -%}
    <div class="panel" style="margin-top:2rem">
      {%- form 'contact', id: 'ContactForm' -%}
        {%- if form.posted_successfully? -%}
          <p class="msg msg--ok" role="status" tabindex="-1" autofocus>{{ 'contact.ok' | t }}</p>
        {%- elsif form.errors -%}
          <div class="msg msg--err" role="alert" tabindex="-1" autofocus>{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <p class="fine">{{ 'general.required' | t }}</p>
        <div class="field"><label for="CName">{{ 'contact.name' | t }}</label><input id="CName" name="contact[name]" autocomplete="name" value="{{ form.name }}"></div>
        <div class="field"><label for="CEmail">{{ 'contact.email' | t }} *</label><input id="CEmail" type="email" name="contact[email]" autocomplete="email" required aria-required="true" value="{{ form.email }}"></div>
        <div class="field"><label for="CBody">{{ 'contact.message' | t }} *</label><textarea id="CBody" name="contact[body]" required aria-required="true">{{ form.body }}</textarea></div>
        <p class="fine">{{ 'contact.privacy' | t }}{% if shop.privacy_policy.body != blank %} <a href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title }}</a>.{% endif %}</p>
        <button class="btn btn--solid" type="submit">{{ 'contact.send' | t }}</button>
      {%- endform -%}
    </div>
  </div>
</section>
{% schema %}
{ "name": "Contact", "settings": [] }
{% endschema %}
