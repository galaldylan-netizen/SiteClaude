{%- paginate blog.articles by 9 -%}
<section class="section page-head">
  <div class="container">
    <p class="label"><span class="blink" aria-hidden="true"></span>{{ 'journal.label' | t }}</p>
    <h1 class="h2" data-scramble>{{ blog.title | escape }}</h1>
    <ul class="journal" role="list" style="margin-top:2.5rem">
      {%- for article in blog.articles -%}
        <li data-reveal style="--i: {{ forloop.index0 | modulo: 3 }}">{% render 'log-card', article: article, index: forloop.index %}</li>
      {%- else -%}
        <li><p>{{ 'journal.empty' | t }}</p></li>
      {%- endfor -%}
    </ul>
    {%- if paginate.pages > 1 -%}{% render 'pagination', paginate: paginate %}{%- endif -%}
  </div>
</section>
{%- endpaginate -%}
{% schema %}
{ "name": "Journal", "settings": [] }
{% endschema %}
