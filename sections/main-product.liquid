{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign form_id = 'ProductForm-' | append: section.id
  assign featured = current_variant.featured_media | default: product.featured_media
-%}
<section class="section section--tight" data-product-section data-section-id="{{ section.id }}" data-url="{{ product.url }}">
  <div class="container product">
    {%- comment -%} ===== Galerie ===== {%- endcomment -%}
    <div class="gallery" data-gallery>
      <div class="gallery__main" data-reveal="clip">
        {%- if featured != blank -%}
          <button type="button" class="gallery__zoom" data-lightbox-open aria-label="{{ 'products.product.zoom' | t }}">
            {%- assign featured_alt = featured.alt | default: product.title | escape -%}
            {{ featured | image_url: width: 1600 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600, 900, 1200, 1600', sizes: '(min-width: 990px) 55vw, 100vw', alt: featured_alt }}
          </button>
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
        {%- endif -%}
      </div>
      {%- if product.media.size > 1 -%}
        <ul class="gallery__thumbs" role="list" aria-label="{{ 'products.product.gallery' | t }}">
          {%- for media in product.media -%}
            {%- if media.media_type == 'image' -%}
              {%- assign media_alt = media.alt | default: product.title | escape -%}
              <li>
                <button type="button" class="gallery__thumb" data-thumb
                  data-src="{{ media | image_url: width: 1600 }}"
                  data-srcset="{{ media | image_url: width: 600 }} 600w, {{ media | image_url: width: 900 }} 900w, {{ media | image_url: width: 1200 }} 1200w, {{ media | image_url: width: 1600 }} 1600w"
                  data-alt="{{ media_alt }}" data-media-id="{{ media.id }}"
                  {% if media.id == featured.id %}aria-current="true"{% else %}aria-current="false"{% endif %}>
                  {{ media | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
                  <span class="visually-hidden">{{ 'products.product.show_image' | t: index: forloop.index, total: product.media.size }}</span>
                </button>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <dialog class="lightbox" data-lightbox aria-label="{{ 'products.product.zoom' | t }}">
      <button type="button" class="icon-button lightbox__close" data-lightbox-close>{% render 'icon', name: 'close' %}<span class="visually-hidden">{{ 'general.close' | t }}</span></button>
      <img src="" alt="" data-lightbox-img>
    </dialog>

    {%- comment -%} ===== Infos produit ===== {%- endcomment -%}
    <div class="product__info">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            <div {{ block.shopify_attributes }}>{% render block %}</div>

          {%- when 'vendor' -%}
            <p class="product__vendor" {{ block.shopify_attributes }}>{{ product.vendor | escape }}</p>

          {%- when 'title' -%}
            <h1 class="product__title split-words" data-split {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>

          {%- when 'rating' -%}
            <div {{ block.shopify_attributes }}>
              {%- if product.metafields.reviews.rating_count.value > 0 -%}
                <a href="#ProductReviews" style="color: inherit; text-decoration: none">{% render 'rating', product: product, show_count: true %}</a>
              {%- endif -%}
            </div>

          {%- when 'price' -%}
            <div class="product__price" data-price-wrapper aria-live="polite" {{ block.shopify_attributes }}>
              {% render 'price', product: product, variant: current_variant, show_note: true, show_lowest: true %}
            </div>

          {%- when 'short_description' -%}
            {%- if product.description != blank -%}
              <p class="product__short" {{ block.shopify_attributes }}>{{ product.description | strip_html | truncatewords: block.settings.words }}</p>
            {%- endif -%}

          {%- when 'variant_picker' -%}
            {%- unless product.has_only_default_variant -%}
              <div data-variant-picker {{ block.shopify_attributes }}>
                {%- for option in product.options_with_values -%}
                  <fieldset class="variant-group">
                    <legend>{{ option.name | escape }} : <span data-option-value="{{ forloop.index0 }}">{{ option.selected_value | escape }}</span></legend>
                    <div class="variant-pills">
                      {%- assign option_index = forloop.index0 -%}
                      {%- for value in option.values -%}
                        {%- assign input_id = section.id | append: '-' | append: option_index | append: '-' | append: forloop.index0 -%}
                        <input type="radio" id="{{ input_id }}" name="{{ option.name | escape }}-{{ section.id }}" value="{{ value | escape }}" data-option-index="{{ option_index }}" form="{{ form_id }}"{% if option.selected_value == value %} checked{% endif %}>
                        <label for="{{ input_id }}">{{ value | escape }}</label>
                      {%- endfor -%}
                    </div>
                  </fieldset>
                {%- endfor -%}
                <script type="application/json" data-variants-json>{{ product.variants | json }}</script>
              </div>
            {%- endunless -%}

          {%- when 'buy_buttons' -%}
            <div {{ block.shopify_attributes }}>
              {%- form 'product', product, id: form_id, class: 'buy', novalidate: 'novalidate', data-product-form: '' -%}
                <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
                <div class="quantity" data-quantity>
                  <button type="button" data-qty-minus>{% render 'icon', name: 'minus' %}<span class="visually-hidden">{{ 'products.product.quantity.decrease' | t: product: product.title | escape }}</span></button>
                  <label for="Quantity-{{ section.id }}" class="visually-hidden">{{ 'products.product.quantity.label' | t }}</label>
                  <input type="number" id="Quantity-{{ section.id }}" name="quantity" value="1" min="1" inputmode="numeric">
                  <button type="button" data-qty-plus>{% render 'icon', name: 'plus' %}<span class="visually-hidden">{{ 'products.product.quantity.increase' | t: product: product.title | escape }}</span></button>
                </div>
                <button type="submit" name="add" class="button button--full" data-add-button data-magnetic {% unless current_variant.available %}disabled{% endunless %}>
                  <span data-add-label>
                    {%- if current_variant.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
                  </span>
                </button>
                {%- if block.settings.show_dynamic_checkout -%}
                  {{ form | payment_button }}
                {%- endif -%}
                <p class="form-message form-message--error" role="alert" data-form-error hidden></p>
              {%- endform -%}
            </div>

          {%- when 'stock' -%}
            <p class="stock{% unless current_variant.available %} stock--out{% endunless %}" data-stock {{ block.shopify_attributes }}>
              {%- if current_variant.available -%}
                {%- if current_variant.inventory_management == 'shopify' and current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= block.settings.low_stock -%}
                  {{ 'products.product.low_stock' | t: count: current_variant.inventory_quantity }}
                {%- else -%}
                  {{ 'products.product.in_stock' | t }}
                {%- endif -%}
              {%- else -%}
                {{ 'products.product.sold_out' | t }}
              {%- endif -%}
            </p>

          {%- when 'trust' -%}
            <ul class="trust" role="list" {{ block.shopify_attributes }}>
              <li>{% render 'icon', name: 'truck' %}<span>{{ settings.delivery_text | escape }}</span></li>
              <li>{% render 'icon', name: 'return' %}<span>{{ 'products.product.trust.withdrawal' | t }}</span></li>
              <li>{% render 'icon', name: 'lock' %}<span>{{ 'products.product.trust.secure' | t }}</span></li>
            </ul>

          {%- when 'collapsible' -%}
            <details class="accordion" {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
              <summary>{{ block.settings.heading | escape }}<span class="plus" aria-hidden="true"></span></summary>
              <div class="accordion__content rte">
                {%- case block.settings.source -%}
                  {%- when 'description' -%}{{ product.description }}
                  {%- when 'shipping' -%}
                    <p>{{ settings.delivery_text | escape }}</p>
                    {%- if shop.shipping_policy.body != blank -%}<p><a href="{{ shop.shipping_policy.url }}">{{ shop.shipping_policy.title }}</a></p>{%- endif -%}
                  {%- when 'returns' -%}
                    <p>{{ 'products.product.withdrawal_text' | t }}</p>
                    <p>
                      {%- if block.settings.withdrawal_page != blank -%}<a href="{{ block.settings.withdrawal_page.url }}">{{ 'sections.footer.withdrawal' | t }}</a>{%- endif -%}
                      {%- if shop.refund_policy.body != blank %} · <a href="{{ shop.refund_policy.url }}">{{ shop.refund_policy.title }}</a>{%- endif -%}
                    </p>
                  {%- when 'gpsr' -%}{% render 'gpsr-info', product: product %}
                  {%- else -%}{{ block.settings.content }}
                {%- endcase -%}
              </div>
            </details>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>

  {%- comment -%} Barre d'achat collante (apparaît quand le bouton principal sort de l'écran) {%- endcomment -%}
  <div class="sticky-atc" data-sticky-atc aria-hidden="true" inert>
    {%- if featured != blank -%}{{ featured | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}
    <div class="sticky-atc__info">
      <strong>{{ product.title | escape }}</strong>
      <span data-sticky-price>{{ current_variant.price | money }}</span>
    </div>
    <button type="submit" form="{{ form_id }}" class="button" {% unless current_variant.available %}disabled{% endunless %} data-sticky-add>{{ 'products.product.add_to_cart' | t }}</button>
  </div>
</section>

{%- comment -%} Données structurées (SEO) — la note n'est ajoutée que si de vrais avis existent. {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": {{ request.origin | append: product.url | json }},
  {%- if product.featured_media -%}"image": [{{ product.featured_media | image_url: width: 1200 | prepend: 'https:' | json }}],{%- endif -%}
  "description": {{ product.description | strip_html | json }},
  {%- if current_variant.sku != blank -%}"sku": {{ current_variant.sku | json }},{%- endif -%}
  "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
  {%- if product.metafields.reviews.rating_count.value > 0 -%}
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": {{ product.metafields.reviews.rating.value.rating | json }},
    "reviewCount": {{ product.metafields.reviews.rating_count.value | json }}
  },
  {%- endif -%}
  "offers": [
    {%- for variant in product.variants -%}
    {
      "@type": "Offer",
      "sku": {{ variant.sku | json }},
      "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
      "price": {{ variant.price | divided_by: 100.0 | json }},
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "url": {{ request.origin | append: variant.url | json }}
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>

{% schema %}
{
  "name": "Fiche produit",
  "class": "section-main-product",
  "blocks": [
    { "type": "@app" },
    { "type": "vendor", "name": "Marque", "limit": 1 },
    { "type": "title", "name": "Titre", "limit": 1 },
    { "type": "rating", "name": "Note (avis)", "limit": 1 },
    { "type": "price", "name": "Prix", "limit": 1 },
    { "type": "short_description", "name": "Description courte", "limit": 1, "settings": [ { "type": "range", "id": "words", "label": "Nombre de mots", "min": 10, "max": 80, "step": 5, "default": 30 } ] },
    { "type": "variant_picker", "name": "Choix des variantes", "limit": 1 },
    { "type": "buy_buttons", "name": "Boutons d'achat", "limit": 1, "settings": [ { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Bouton de paiement express (Apple Pay, Google Pay, Shop Pay…)", "default": true } ] },
    { "type": "stock", "name": "Disponibilité", "limit": 1, "settings": [ { "type": "range", "id": "low_stock", "label": "Seuil « stock faible »", "min": 1, "max": 20, "step": 1, "default": 5, "info": "Affiche le stock réel uniquement si Shopify suit l'inventaire. Aucun faux compteur." } ] },
    { "type": "trust", "name": "Réassurance", "limit": 1 },
    {
      "type": "collapsible",
      "name": "Onglet repliable",
      "settings": [
        { "type": "text", "id": "heading", "label": "Titre", "default": "Détails" },
        { "type": "select", "id": "source", "label": "Contenu", "default": "custom", "options": [
          { "value": "description", "label": "Description du produit" },
          { "value": "shipping", "label": "Livraison" },
          { "value": "returns", "label": "Rétractation & retours" },
          { "value": "gpsr", "label": "Sécurité du produit (GPSR, obligatoire UE)" },
          { "value": "custom", "label": "Texte personnalisé" }
        ] },
        { "type": "richtext", "id": "content", "label": "Texte personnalisé" },
        { "type": "page", "id": "withdrawal_page", "label": "Page « Se rétracter » (pour le contenu Rétractation)" },
        { "type": "checkbox", "id": "open", "label": "Ouvert par défaut", "default": false }
      ]
    }
  ]
}
{% endschema %}
