<section class="section">
  <div class="container not-found">
    <div>
      <p class="label" style="justify-content:center"><span class="blink" aria-hidden="true"></span>{{ 'password.label' | t }}</p>
      <h1 class="h1" data-scramble>{{ settings.site_name | escape }}</h1>
      {%- if shop.password_message != blank -%}<p class="lead" style="margin-inline:auto">{{ shop.password_message }}</p>{%- endif -%}
      {%- form 'storefront_password' -%}
        {%- if form.errors -%}<p class="msg msg--err" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
        <div class="search-row" style="justify-content:center;margin-top:2rem">
          <label for="Pw" class="visually-hidden">{{ 'password.field' | t }}</label>
          <input id="Pw" type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.field' | t }}">
          <button class="btn btn--solid" type="submit">{{ 'password.enter' | t }}</button>
        </div>
      {%- endform -%}
    </div>
  </div>
</section>
{% schema %}
{ "name": "Mot de passe", "settings": [] }
{% endschema %}
