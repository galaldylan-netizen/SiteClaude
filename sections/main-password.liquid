<section class="hero" style="margin-top:0; padding-top:0">
  <div class="hero__mist" aria-hidden="true"><span></span><span></span><span></span></div>
  <div class="container" style="text-align:center; max-width: 640px">
    <h1 class="h1">{{ shop.name }}</h1>
    {%- if shop.password_message != blank -%}<p class="hero__text" style="margin-inline:auto">{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'storefront_password' -%}
      {%- if form.errors -%}<p class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
      <div class="newsletter__form">
        <label for="Password" class="visually-hidden">{{ 'general.password' | t }}</label>
        <input type="password" name="password" id="Password" autocomplete="current-password" placeholder="{{ 'general.password' | t }}">
        <button type="submit" class="button button--light">{{ 'general.enter' | t }}</button>
      </div>
    {%- endform -%}
  </div>
</section>
{% schema %}
{ "name": "Mot de passe", "settings": [] }
{% endschema %}
