<section class="section section--tight" data-cart-page>
  <div class="container">
    <h1 class="h2">{{ 'cart.title' | t }}</h1>
    {%- if cart.item_count > 0 -%}
      <div class="cart-page">
        <div data-cart-body>{% render 'cart-items', context: 'page' %}</div>
        <aside class="cart-page__summary" aria-label="{{ 'cart.summary' | t }}">
          {% render 'cart-summary' %}
          <form action="{{ routes.cart_url }}" method="post" novalidate>
            {%- if section.settings.show_note -%}
              <div class="field">
                <label for="CartNote">{{ 'cart.note' | t }}</label>
                <textarea id="CartNote" name="note">{{ cart.note }}</textarea>
              </div>
            {%- endif -%}
            <button type="submit" name="checkout" class="button button--full">{{ 'cart.checkout' | t }} {% render 'icon', name: 'lock' %}</button>
          </form>
          {%- if additional_checkout_buttons -%}
            <div>{{ content_for_additional_checkout_buttons }}</div>
          {%- endif -%}
        </aside>
      </div>
    {%- else -%}
      <div class="drawer__empty">
        <p>{{ 'cart.empty' | t }}</p>
        <a class="button" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }} {% render 'icon', name: 'arrow' %}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Panier",
  "settings": [ { "type": "checkbox", "id": "show_note", "label": "Note de commande", "default": false } ]
}
{% endschema %}
