<div class="drawer" id="CartDrawer" data-cart-drawer hidden>
  <button type="button" class="drawer__overlay" data-cart-close tabindex="-1" aria-hidden="true"></button>
  <div class="drawer__panel" role="dialog" aria-modal="true" aria-labelledby="CartDrawerTitle">
    <div class="drawer__header">
      <h2 id="CartDrawerTitle">{{ 'cart.title' | t }}{% if cart.item_count > 0 %} <span class="visually-hidden">, </span><small style="font-family: var(--font-body); font-size: 1rem; color: var(--color-text-muted)">({{ cart.item_count }})</small>{% endif %}</h2>
      <button type="button" class="icon-button" data-cart-close>{% render 'icon', name: 'close' %}<span class="visually-hidden">{{ 'general.close' | t }}</span></button>
    </div>

    {%- if cart.item_count > 0 -%}
      <div class="drawer__body" data-cart-body>
        {% render 'cart-items', context: 'drawer' %}
      </div>
      <div class="drawer__footer">
        {% render 'cart-summary' %}
        <form action="{{ routes.cart_url }}" method="post" id="CartDrawerForm">
          <button type="submit" name="checkout" class="button button--full">{{ 'cart.checkout' | t }} {% render 'icon', name: 'lock' %}</button>
        </form>
        <a href="{{ routes.cart_url }}" class="link-arrow" style="justify-self:center"><span>{{ 'cart.view_cart' | t }}</span></a>
      </div>
    {%- else -%}
      <div class="drawer__body">
        <div class="drawer__empty">
          <p class="h3">{{ 'cart.empty' | t }}</p>
          <a class="button" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }} {% render 'icon', name: 'arrow' %}</a>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Tiroir panier",
  "settings": []
}
{% endschema %}
