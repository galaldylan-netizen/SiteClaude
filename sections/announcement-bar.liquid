{%- if section.blocks.size > 0 -%}
  <div class="announcement" role="region" aria-label="{{ 'sections.announcement.label' | t }}">
    {%- comment -%} Texte lisible une seule fois pour les lecteurs d'écran ; la version animée est masquée. {%- endcomment -%}
    <p class="visually-hidden">
      {%- for block in section.blocks -%}{{ block.settings.text | escape }}{% unless forloop.last %}. {% endunless %}{%- endfor -%}
    </p>
    <div class="announcement__track" aria-hidden="true">
      {%- for i in (1..2) -%}
        {%- for n in (1..3) -%}
          {%- for block in section.blocks -%}
            <span {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</span>
          {%- endfor -%}
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Barre d'annonce",
  "class": "section-announcement",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Texte", "default": "Paiement sécurisé" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Barre d'annonce",
      "blocks": [
        { "type": "message", "settings": { "text": "Diffuseurs d'arômes au design épuré" } },
        { "type": "message", "settings": { "text": "14 jours pour changer d'avis" } },
        { "type": "message", "settings": { "text": "Paiement sécurisé" } }
      ]
    }
  ]
}
{% endschema %}
