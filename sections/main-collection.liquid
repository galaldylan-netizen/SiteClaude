{%- paginate collection.products by 24 -%}
<section class="section page-head">
  <div class="container">
    <p class="label">{{ 'object.collection' | t }}</p>
    <h1 class="h2" data-scramble>{{ collection.title | escape }}</h1>
    <ul class="journal" role="list" style="margin-top:2rem">
      {%- for product in collection.products -%}
        <li><article class="log"><div class="panel"><h2 class="h3"><a href="{{ product.url }}">{{ product.title | escape }}</a></h2><p>{{ product.description | strip_html | truncatewords: 20 }}</p></div></article></li>
      {%- else -%}
        <li><p>{{ 'object.empty' | t }}</p></li>
      {%- endfor -%}
    </ul>
    {%- if paginate.pages > 1 -%}{% render 'pagination', paginate: paginate %}{%- endif -%}
  </div>
</section>
{%- endpaginate -%}
{% schema %}
{ "name": "Collection", "settings": [] }
{% endschema %}
