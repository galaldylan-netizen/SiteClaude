<article class="section section--tight">
  <div class="container narrow">
    <p class="eyebrow"><time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: format: 'date' }}</time></p>
    <h1 class="split-words" data-split>{{ article.title | escape }}</h1>
    {%- if article.image -%}
      <div data-reveal="clip" style="border-radius: var(--radius-lg); overflow: hidden; margin-block: 2rem">
        {%- assign a_alt = article.image.alt | escape -%}
        {{ article.image | image_url: width: 1600 | image_tag: loading: 'eager', widths: '600, 900, 1200, 1600', sizes: '(min-width: 800px) 760px, 100vw', alt: a_alt }}
      </div>
    {%- endif -%}
    <div class="rte">{{ article.content }}</div>
  </div>
</article>
{% schema %}
{ "name": "Article", "settings": [] }
{% endschema %}
