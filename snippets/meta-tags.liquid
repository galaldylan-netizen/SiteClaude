{%- liquid
  assign og_title = page_title | default: settings.site_name
  assign og_description = page_description | default: settings.site_tagline
-%}
<meta property="og:site_name" content="{{ settings.site_name | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="website">
<meta property="og:description" content="{{ og_description | escape }}">
{%- if page_image -%}
  <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": {{ settings.site_name | json }},
    "url": {{ request.origin | append: routes.root_url | json }},
    "inLanguage": {{ request.locale.iso_code | json }}
  }
</script>
