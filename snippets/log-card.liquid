<article class="log" aria-labelledby="Log-{{ article.id }}">
  <div class="panel">
    <div class="log__meta"><span>LOG-{{ article.id | modulo: 10000 }}</span><b><time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%d.%m.%Y' }}</time></b></div>
    {%- if article.image -%}
      <div class="log__img">{{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 990px) 30vw, 100vw', alt: '' }}</div>
    {%- endif -%}
    <h3 id="Log-{{ article.id }}"><a href="{{ article.url }}">{{ article.title | escape }}</a></h3>
    <p>{{ article.excerpt_or_content | strip_html | truncatewords: 26 }}</p>
    <span class="log__more" aria-hidden="true">{{ 'journal.read' | t }} →</span>
  </div>
</article>
