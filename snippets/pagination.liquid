<nav class="pagination" aria-label="{{ 'general.pagination.label' | t }}">
  {%- if paginate.previous -%}
    <a href="{{ paginate.previous.url }}">{% render 'icon', name: 'arrow-left' %}<span class="visually-hidden">{{ 'general.previous' | t }}</span></a>
  {%- endif -%}
  {%- for part in paginate.parts -%}
    {%- if part.is_link -%}
      <a href="{{ part.url }}"><span class="visually-hidden">{{ 'general.pagination.page' | t }} </span>{{ part.title }}</a>
    {%- elsif part.title == paginate.current_page -%}
      <span aria-current="page"><span class="visually-hidden">{{ 'general.pagination.page' | t }} </span>{{ part.title }}</span>
    {%- else -%}
      <span>{{ part.title }}</span>
    {%- endif -%}
  {%- endfor -%}
  {%- if paginate.next -%}
    <a href="{{ paginate.next.url }}">{% render 'icon', name: 'arrow' %}<span class="visually-hidden">{{ 'general.next' | t }}</span></a>
  {%- endif -%}
</nav>
